# Copy to .env.local for local development. Never commit real values.

# Leave empty locally to use the built-in PGlite database in ./.data/pglite.
# In Vercel: the Supabase "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Random 32+ character string used to sign login sessions. Different per environment.
SESSION_SECRET=

# First admin account, created by `npm run db:seed`. Change the password after first sign-in.
ADMIN_USERNAME=paul
ADMIN_DISPLAY_NAME=Paul Charteris
ADMIN_PASSWORD=
